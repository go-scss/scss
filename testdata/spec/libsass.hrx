  }
}
@media only screen and (min-width: 1120px) and (max-width: 1280px) {
  body.immobile & {
    margin-bottom: 0;
  }
}
@media only screen and (min-width: 1280px) {
  body.immobile & {
    margin-bottom: 0;
  }
}

