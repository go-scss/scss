<===> case6/input.scss
foo {
  @at-root {
    %placeholder {
      color: red;
    }
  }

  baz {
    @at-root {
      %other-placeholder {
        color: blue;
      }
    }
  }
}

bar {
  @extend %placeholder;
}

baz {
  @extend %other-placeholder;
}

<===> case6/output.css
bar {
  color: red;
}
baz {
  color: blue;
}

<===> case7/input.scss
foo {
  color: red;

  @at-root {
    @keyframes animation {
      to { color: red; }
    }
  }

  bar {
    color: blue;

    @at-root {
      @keyframes other-animation {
        to { color: blue; }
      }
    }
  }
}

<===> case7/output.css
foo {
  color: red;
}
@keyframes animation {
  to {
    color: red;
  }
}
foo bar {
  color: blue;
}
@keyframes other-animation {
  to {
    color: blue;
  }
}

<===> case8/input.scss
foo {
  @at-root {
    @media print {
      bar {
        color: red;
      }
    }

    baz {
      @media speech {
        color: blue;
      }
    }
  }
}

<===> case8/output.css
@media print {
  bar {
    color: red;
  }
}
@media speech {
  baz {
    color: blue;
  }
}

