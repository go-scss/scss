@use "sass:meta";
// Regression test for sass/libsass#2842
@mixin test-content-exists() {
  @if meta.content-exists() {
    @content;
  }
  @else {
    content-exists: false;
  }
}

a {
  @include test-content-exists();
}

<===> case41/output.css
a {
  content-exists: false;
}

<===> case42/input.scss
@use "sass:meta";
// Regression test for sass/libsass#2842
@mixin test-content-exists() {
  @if meta.content-exists() {
    @content;
  }
  @else {
    content-exists: false;
  }
}

a {
  @include test-content-exists() {
    content: present;
  }
}

<===> case42/output.css
a {
  content: present;
}

