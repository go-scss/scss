  --list: (a b c);
  --map: (a: b, c: d);
}

<===> case14/input.scss
.strings {
  // Strings are tokenized as units, so their contents shouldn't affect anything
  // else.
  --text: "foo";
  --bang: "!";
  --semicolon: ";";
  --square: "][";
  --curly: "}{";
  --parens: ")(";
}

<===> case14/output.css
.strings {
  --text: "foo";
  --bang: "!";
  --semicolon: ";";
  --square: "][";
  --curly: "}{";
  --parens: ")(";
}

