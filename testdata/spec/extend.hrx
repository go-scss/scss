// Regression test for sass/dart-sass#1109.
.a .b {
  c: d;
}

.a.mod1, .a.mod2 {
  @extend .a, .b;
}
.a.mod3, .a.mod4 {
  @extend .a, .b;
}
.a.mod5, .a.mod6 {
  @extend .a, .b;
}

<===> case0/output.css
.a .b, .a .a.mod5, .a .a.mod6, .a .a.mod3, .a .a.mod4, .a .a.mod1, .a .a.mod2 {
  c: d;
}

