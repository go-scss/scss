<===> case55/input.scss
// Overriding the variable inside the loop will not impact the end of the loop.
$limit: 4;

@for $i from 1 through $limit {
  $limit: 2;
  a {
    limit: $limit;
    i: $i;
  }
}

<===> case55/output.css
a {
  limit: 2;
  i: 1;
}

a {
  limit: 2;
  i: 2;
}

a {
  limit: 2;
  i: 3;
}

a {
  limit: 2;
  i: 4;
}

