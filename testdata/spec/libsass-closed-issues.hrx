<===> case58/input.scss
@use "sass:list";
@function double($value) {
  @return $value * 2;
}

@mixin dummy-bug($args...) {
  @for $i from 1 through list.length($args) {
    $args: list.set-nth($args, $i, double(list.nth($args, $i)));
  }

  content: $args;
}

.foo {
  @include dummy-bug(1, 2, 3, 4);
}

<===> case58/output.css
.foo {
  content: 2, 4, 6, 8;
}

