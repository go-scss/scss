<===> case31/input.scss
@use "sass:meta";

$count: 0;

@function counter() {
  $count: $count + 1 !global;
  @return $count;
}

$map: (
  counter(): 'bar',
  counter(): 'foo',
);

.foo {
  content: meta.inspect($map);
}

<===> case31/output.css
.foo {
  content: (1: "bar", 2: "foo");
}

<===> case32/input.scss
@use "sass:meta";

$map1: (
   red: 'bar',
  'red': 'foo',
);

$map2: (
   red: 'bar',
  'red': #{red},
);

.foo {
  content: meta.inspect($map1);
  content: meta.inspect($map2);
}

<===> case32/output.css
.foo {
  content: (red: "bar", "red": "foo");
  content: (red: "bar", "red": red);
}

