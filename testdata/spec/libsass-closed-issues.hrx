  /* nothing */
}

.theme1 .something, .theme2 .something {
  /* nothing */
}

<===> case1/input.scss
%button-styles {
  color: red;

  &:focus {
    color: blue;
  }
}

[type="button"] {
  @extend %button-styles;
}

<===> case1/output.css
[type=button] {
  color: red;
}
[type=button]:focus {
  color: blue;
}

<===> case2/input.scss
div {
    top: 10px - 2 * 5px /* arrow size */;
}

<===> case2/output.css
div {
  top: 0px;
}

<===> case3/input.scss
@mixin m() {
  .a & {
    @content;
  }
}

:not(:last-of-type) {
  top: 10px;
  @include m {
    top: 10px;
  }
}

<===> case3/output.css
:not(:last-of-type) {
  top: 10px;
}
.a :not(:last-of-type) {
  top: 10px;
}

<===> case4/input.scss
@mixin will-change() {
  @supports (will-change: transform) {
    will-change: transform;
  }
}
div {
  a {
    top: 10px;
    @include will-change();
  }
}

<===> case4/output.css
div a {
  top: 10px;
}
@supports (will-change: transform) {
  div a {
    will-change: transform;
  }
}

<===> case5/input.scss
@mixin all-vip() {
  test: vip;
}
@mixin gold() {
  test: gold;
}
@mixin platinum() {
  test: platinum;
}

@mixin icons-sprite($icon-name){
    @if $icon-name == 'all-vip' {
        @include all-vip();
    }
    @else if $icon-name == 'gold' {
        @include gold();
    }
    @else if $icon-name == 'platinum' {
        @include platinum();
    }
}

div {
  @include icons-sprite("platinum");
  @include icons-sprite("all-vip");
  @include icons-sprite("gold");
}
div {
  @include icons-sprite(platinum);
  @include icons-sprite(all-vip);
  @include icons-sprite(gold);
}

<===> case5/output.css
div {
  test: platinum;
  test: vip;
  test: gold;
}

div {
  test: platinum;
  test: vip;
}

