<===> case0/input.scss
@use "sass:selector";
.theme1, .theme2 {
  .something {
    /* nothing */
  }
}

$sel: selector.nest('.theme1, .theme2', '.something');
  
#{$sel} {
  /* nothing */
}

<===> case0/output.css
