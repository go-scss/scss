<===> case23/input.scss
@use "sass:meta";
@function foo($map) {
    @return $map;
}

a {
    $map: foo((this: is, my: map));
    @each $k, $v in $map {
        #{$k}: $v;
    }
}

b {
    $map: meta.call("foo", (this: is, my: map));
    @each $k, $v in $map {
        #{$k}: $v;
    }
}

<===> case23/output.css
a {
  this: is;
  my: map;
}

b {
  this: is;
  my: map;
}

<===> case24/input.scss
@use "sass:meta";
@function foo($this, $my) {
  @return (this: $this, my: $my);
}

a {
  $map: foo((this: is, my: map)...);
  @each $k, $v in $map {
    #{$k}: $v;
  }
}

b {
  $map: meta.call("foo", (this: is, my: map)...);
  @each $k, $v in $map {
    #{$k}: $v;
  }
}

<===> case24/output.css
a {
  this: is;
  my: map;
}

b {
  this: is;
  my: map;
}

